modules = ["nodejs-20", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && pnpm dev"
waitForPort = 8080

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/skillmarket && pnpm dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3001

[[ports]]
localPort = 5003
externalPort = 3002

[[ports]]
localPort = 5095
externalPort = 5000

[[ports]]
localPort = 5096
externalPort = 4200

[[ports]]
localPort = 5098
externalPort = 3003

[[ports]]
localPort = 8080
externalPort = 8080

[userenv]

[userenv.shared]
FROM_EMAIL = "noreply@skillmarket.ai"
LOG_LEVEL = "info"

[deployment]
deploymentTarget = "cloudrun"
run = ["bash", "-c", "NODE_ENV=production PORT=5000 node artifacts/api-server/dist/index.js"]
build = ["bash", "build.sh"]
